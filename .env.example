# 复制本文件为同目录下的 .env 并填入真实值（.env 不要提交到代码仓库）
# docker compose 会自动读取同目录 .env

# 阿里百炼（DashScope）API Key：对话模型与向量模型共用，必填
DASHSCOPE_API_KEY=sk-xxx

# 可选：自定义对话模型 / 接入点（默认 qwen-plus）
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# MySQL root 密码（容器内连接使用，与 init.sql 无关）
MYSQL_ROOT_PASSWORD=root123456

# 可选：百度千帆搜索 API Key（联网搜索工具，不填则禁用联网搜索）
BAIDU_API_KEY=

# 管理员用户名白名单（逗号分隔）。登录/注册这些用户名即拥有管理后台权限，默认 admin
ADMIN_USERNAMES=admin
