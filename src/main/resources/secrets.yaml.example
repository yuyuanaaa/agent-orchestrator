# 本地密钥与连接信息样例
# 使用方式：复制本文件为同目录下的 secrets.yaml，填入真实值后即可覆盖 application.yaml 中的环境变量占位符。
# secrets.yaml 已被 .gitignore 忽略，请勿提交到代码仓库。

spring:
  redis:
    host: 你的Redis地址
    port: 6379
    password:
  datasource:
    url: jdbc:mysql://localhost:3306/agent_platform?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&nullCatalogMeansCurrent=true
    username: root
    password: 你的密码
  ai:
    openai:
      # 对话模型（通义千问 qwen-plus）与向量模型（text-embedding-v4）共用同一个百炼 Key
      chat:
        api-key: 你的阿里百炼 API Key
      embedding:
        api-key: 你的阿里百炼 API Key

app:
  baidu:
    api:
      key: 你的百度千帆 AI 搜索 API Key
